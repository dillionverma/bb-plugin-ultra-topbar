{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "handoff.ts",
    "*.test.ts",
    "*.test.tsx",
    "vitest.config.ts",
    "components",
    "lib",
    "host.ts",
    "pr-contract.ts",
    "hooks"
  ]
}
